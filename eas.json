{
  "cli": {
    "version": ">= 7.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.11:3000/api/v1"
      }
    },
    "preview": {
      "channel": "staging",
      "distribution": "internal"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://vnu-time-table.digitalidea.ua/api/v1"
      },
      "ios": {
        "image": "latest"
      },
      "android": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "vnu-time-table-play-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "sergiy.matrunchyk@gmail.com",
        "ascAppId": "6478240287",
        "appleTeamId": "A6R6EV6YP7"
      }
    }
  }
}
