{
  "expo": {
    "name": "VNU Time Table",
    "slug": "vnu-time-table",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vnu-time-table",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitalidea.vnutimetable",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.digitalidea.vnutimetable"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "3f9b531e-d032-4853-9a94-71f368e7fed8"
      }
    },
    "owner": "digital-idea",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "@sentry/react-native/expo",
        {
          "project": "vnu-time-table",
          "organization": "digital-idea"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for weather forecasts."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep public class com.digitalidea.vnutimetable.** {*;}",
            "allowBackup": false
          }
        }
      ]
    ],
    "locales": {
      "en": "./languages/en.json",
      "uk": "./languages/uk.json"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3f9b531e-d032-4853-9a94-71f368e7fed8"
    }
  }
}
